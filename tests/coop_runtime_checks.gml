checks = 0;
check = function(_ok, _label) {
    if (!_ok) show_error("TEST FAIL: " + _label, true);
    checks += 1;
    show_debug_message("PASS: " + _label);
};
var _body = instance_find(obj_player, 0);
var _team = _body.team;
var _aim = _body.aim_controller;
check(instance_number(obj_team) == 1, "one shared persistent energy manager");
check(_team.energy_max == 100 && _team.action_energy_cost == 5, "energy configuration");
_team.energy = 0; _team.regen_elapsed = 0;
_team.advance_energy(0.5); check(_team.energy == 0, "no early regeneration");
_team.advance_energy(0.5); check(_team.energy == 1, "one energy after one second");
_team.advance_energy(250); check(_team.energy == 100, "energy capped at 100");
check(_team.try_spend(5) && _team.energy == 95, "shot spends exactly five");
_team.advance_energy(0.5); check(_team.energy == 95, "no banked regeneration at cap");
check(!_team.try_spend(-5) && _team.energy == 95, "negative spending rejected");
_team.energy = 0; check(!_team.try_spend(5) && _team.energy == 0, "insufficient energy rejected");
check(_aim.ghost_alpha == 0.6 && _aim.ghost_move_radius == 120, "ghost configuration");
_aim.x = _body.x + 200;
_aim.y = _body.y;
_aim.clamp_ghost_position();
check(point_distance(_body.x, _body.y, _aim.x, _aim.y) <= _aim.ghost_move_radius + 0.01, "ghost stays within tether");
_aim.x = _body.x;
_aim.y = _body.y;
_aim.aim_angle = 0;
var _ghost_range = _aim.ghost_vision_range;
_aim.ghost_vision_range = 0;
check(coop_visible(_body, _body.x + 32, _body.y), "target inside hunter cone visible");
check(!coop_visible(_body, _body.x - 32, _body.y), "target behind hunter hidden without ghost vision");
_aim.ghost_vision_range = _ghost_range;
check(coop_visible(_body, _body.x - 32, _body.y), "ghost reveals behind hunter");
_aim.x = _body.x + 20;
check(_aim.aim_angle == 0, "moving ghost does not change hunter facing");
_aim.x = _body.x;
check(coop_wall_distance(_aim,_body.x,_body.y,0,32) == -1, "clear ray misses walls");
var _door = instance_create_depth(_body.x+40,_body.y-16,0,obj_door);
var _door_point = _door.get_interaction_point(_body);
check(coop_visible(_body,_door_point.x,_door_point.y,_door), "door is visible at its surface");
var _door_blocker = instance_create_depth(_body.x+20,_body.y-16,0,obj_wall);
check(!coop_visible(_body,_door_point.x,_door_point.y,_door), "another wall still blocks the door");
instance_destroy(_door_blocker);
_team.energy = 100;
check(!_door.interact(_body) && !_door.is_open, "hunter cannot directly interact with door");
_aim.x = _body.x - 40;
check(!_aim.update_interaction(true) && !_door.is_open && _team.energy == 100, "nearby hunter cannot open door when ghost is far");
_aim.x = _body.x + 20;
var _body_start_x = _body.x;
_body.x -= 80;
check(_aim.update_interaction(true) && _door.is_open, "nearby ghost opens door even when hunter is far");
check(_aim.update_interaction(true) && !_door.is_open, "nearby ghost closes door");
_body.x = _body_start_x;
_aim.x = _body.x;
instance_destroy(_door);
var _near = instance_create_depth(_body.x+100,_body.y,0,par_enemy);
var _far = instance_create_depth(_body.x+180,_body.y,0,par_enemy);
_team.energy=100;
check(_body.fire_shot(), "shot accepted");
check(!instance_exists(_near) && instance_exists(_far), "one shot kills nearest only");
check(_team.energy==95, "hit consumes five energy");
var _wall = instance_create_depth(_body.x+40,_body.y-16,0,obj_wall);
check(!coop_visible(_body,_far.x,_far.y), "wall blocks vision");
var _wall_distance = coop_wall_distance(_aim,_body.x,_body.y,0,100);
check(_wall_distance >= 38 && _wall_distance <= 41, "wall stops ray at placed wall");
check(_body.fire_shot() && instance_exists(_far), "wall blocks shot");
check(_team.energy==90, "blocked shot still costs five");
instance_destroy(_wall);
_team.energy=0;
check(!_body.fire_shot() && instance_exists(_far), "empty pool cannot kill enemy");
instance_destroy(_far);
_team.energy=100; _team.regen_elapsed=0;
check(_body.fire_shot() && _team.energy==95, "miss still costs five");
_team.energy=100; _body.shot_time=0;
_team.feedback=""; _team.feedback_time=0;
instance_create_depth(_body.x+160,_body.y,0,par_enemy);
instance_create_depth(_body.x+45,_body.y+15,0,par_interactable);
show_debug_message("COOP TESTS PASSED: " + string(checks));
alarm[1]=3;
